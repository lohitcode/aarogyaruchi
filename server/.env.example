ENV=development
PORT=8080

DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable
CACHE_URL=localhost:6379

# MSG91 (for production OTP delivery)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Z.AI chatbot (public /chat/stream endpoint)
ZAI_API_KEY=
ZAI_MODEL=glm-4.7
# GLM Coding Plan keys use the coding endpoint; pay-as-you-go keys use
# https://api.z.ai/api/paas/v4
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# Comma-separated browser origins allowed to call the chat API
CHAT_ALLOWED_ORIGINS=https://aarogyaruchi.com,http://localhost:3000

# ---- Platform (ordering / admin / delivery) ----

# Browser origins allowed to call the /v1 API with credentials
# (customer site + standalone ops app; add dev origins locally).
ALLOWED_ORIGINS=https://aarogyaruchi.com,https://www.aarogyaruchi.com,https://admin.aarogyaruchi.com,http://localhost:3000

# Pins every OTP to 123456 for staging/pre-launch. Keep false in production;
# the code is never logged or returned by API responses either way.
OTP_FIXED_ENABLED=false

# Per-device idle window for web sessions (hours). A device that makes no
# authenticated request for this long is logged out — its session key
# expires in Valkey while other devices keep their own sessions. Activity
# slides the window forward. Default: 168 (7 days).
SESSION_TTL_HOURS=168

# Privileged accounts provisioned at boot (comma-separated E.164 phones).
# Exact values are supplied per environment, never committed.
SEED_ADMIN_PHONES=+919999999999
SEED_PARTNER_PHONES=+919999999998

# HS256 secret signing delivery-partner access tokens. REQUIRED in
# production (the server refuses to boot without it there).
PARTNER_TOKEN_SECRET=

# Timezone for all batch/cutoff math.
BUSINESS_TIMEZONE=Asia/Kolkata

# Product image uploads: the Go API mints short-lived HMAC upload URLs and
# the images-cdn Cloudflare Worker (R2 binding) stores the bytes. The secret
# must match the worker's UPLOAD_SECRET (wrangler secret put UPLOAD_SECRET).
R2_UPLOAD_SECRET=
IMAGES_CDN_BASE=https://images-cdn.lohit.workers.dev

# Cloudflare (for Terraform DNS setup)
TF_VAR_cloudflare_api_token=
TF_VAR_cloudflare_zone_id=
