# Cloudflare Workers Deployment
# Copy to .env and fill in values

# API Token with Workers permissions
# Create at: Cloudflare Dashboard → My Profile → API Tokens → Create Token
# Use "Edit Cloudflare Workers" template or custom with:
#   - Account: Workers Scripts (Edit)
#   - Account: Workers Routes (Edit)
#   - Zone: Workers Routes (Edit)
#   - Zone: Zone (Read)
CLOUDFLARE_API_TOKEN=your_token_here

# Account ID from: Cloudflare Dashboard → Workers & Pages → Overview (right sidebar)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
