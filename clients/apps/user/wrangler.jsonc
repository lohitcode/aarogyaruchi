{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aarogyaruchi-user",
  "compatibility_date": "2025-01-26",
  "compatibility_flags": ["nodejs_compat"],
  // Our own worker entry (threads the Cloudflare env into the SSR request
  // context so loaders can read KV bindings). NOTE: under
  // @cloudflare/vite-plugin this field is authoritative — the plugin's
  // virtual worker entry literally re-exports `main` — so TanStack's
  // documented `@tanstack/react-start/server-entry` specifier would
  // silently bypass src/server.ts (see docs/feature-2026-08-29-og-edge-cache.md).
  "main": "./src/server.ts",
  // Link-preview (Open Graph) metadata, key = product slug. Written by the
  // images-cdn worker's /og/* endpoint on every product mutation (see
  // server/internal/cfkv); read during SSR by the $slug route's loader with
  // the build-time snapshot as fallback.
  "kv_namespaces": [
    { "binding": "OG_CATALOG", "id": "fa0f19e0df5c4dadbcfe9d44fade9f0b" }
  ],
  "routes": [
    { "pattern": "aarogyaruchi.com", "custom_domain": true },
    { "pattern": "www.aarogyaruchi.com", "custom_domain": true }
  ]
}
