{
  "name": "images-cdn",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-01",
  // account_id is NOT committed (public repo). Export CLOUDFLARE_ACCOUNT_ID
  // before `bunx wrangler deploy`, or let wrangler resolve the account from
  // the logged-in profile (see clients/.env.example).
  "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "aarogyaruchi-products" }],
  // Link-preview (Open Graph) metadata, key = product slug. Written by this
  // worker's HMAC-authed /og/* endpoint (Go post-commit hook), read by the
  // aarogyaruchi-user worker for SSR meta tags.
  "kv_namespaces": [{ "binding": "OG_CATALOG", "id": "fa0f19e0df5c4dadbcfe9d44fade9f0b" }],
  // Browser origins allowed to PUT /upload (admin panel image uploads).
  // Keep in sync with the code default in src/index.ts.
  "vars": {
    "UPLOAD_ALLOWED_ORIGINS": "https://aarogyaruchi.com,https://www.aarogyaruchi.com,https://admin.aarogyaruchi.com,https://dev-admin.aarogyaruchi.com,http://localhost:3000,http://localhost:3001"
  }
}
